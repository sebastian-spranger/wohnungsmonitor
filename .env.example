# Vorlage für lokale Secrets. Kopieren nach `.env` und ausfüllen:
#   cp .env.example .env
#
# Die echte .env ist in .gitignore und wird NIE committet.
# Token bekommst du von @BotFather in Telegram (/newbot oder /token).

TELEGRAM_TOKEN=

# Ein oder mehrere Empfänger, kommagetrennt.
# Nur du:            TELEGRAM_CHAT_ID=12345678
# Du + ein Freund:   TELEGRAM_CHAT_ID=12345678,98765432
# Chat-IDs findest du mit:  python monitor.py --chats
TELEGRAM_CHAT_ID=
